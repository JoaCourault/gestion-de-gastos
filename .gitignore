# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.log
coverage/

# macOS / Windows
.DS_Store
*.pem
Thumbs.db
desktop.ini

# editores: de .vscode/ solo se comparten las extensiones recomendadas
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sublime-workspace

# Claude Code: preferencias locales de cada máquina
.claude/settings.local.json

# env files (claves de Supabase): solo se versiona el ejemplo
.env
.env.*
.env*.local
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
.gradle/

# builds y firmas de Android
*.apk
*.aab
*.keystore
credentials.json

# Supabase CLI (estado local)
supabase/.temp/
supabase/.branches/

# datos personales (no subir a git)
Datos.xlsx
~$*.xlsx
datos-iniciales.json
*.backup.json
gastos-*.json

# volcados de resúmenes de tarjeta (datos personales)
importacion-*/
