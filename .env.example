# Copiá este archivo como .env.local y elegí UN backend. Ver ARCHITECTURE.md.
# Estas variables quedan dentro del APK al compilar: cambiar de backend = editar y recompilar.

# ── Opción A: Supabase ──
# Project Settings → API. NUNCA pongas la service_role / secret key acá.
EXPO_PUBLIC_BACKEND=supabase
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-o-anon-key

# ── Opción B: servidor propio (server/, docker compose) ──
# Desde el celular usá la IP de la PC en la red (ej. http://192.168.0.10:8787), no localhost.
# EXPO_PUBLIC_BACKEND=api
# EXPO_PUBLIC_API_URL=http://localhost:8787
