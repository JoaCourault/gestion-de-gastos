# Copiar como server/.env y completar. Lo usan docker-compose.yml y `npm run dev`.

# ── Postgres del docker-compose (si usás uno externo, ignorá estas tres) ──
POSTGRES_DB=gastos
POSTGRES_USER=gastos
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Conexión que usa la API. Con docker-compose el host es "db"; corriendo la API fuera de Docker, "localhost".
# Cualquier Postgres 13+ sirve: postgres://usuario:clave@host:5432/base
DATABASE_URL=postgres://gastos:cambiar-por-una-clave-larga@db:5432/gastos

# Secreto para firmar los tokens (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

PORT=8787
# URL con la que la app y los links de los emails llegan a esta API
PUBLIC_URL=http://localhost:8787
# Orígenes permitidos para la versión web (coma); '*' = cualquiera
CORS_ORIGINS=*

# Registro abierto desde la app. Con false, los usuarios se crean con: npm run cli -- user:create
SIGNUP_ENABLED=true
# Confirmación de email obligatoria (recomendado). Sin SMTP, el link aparece en el log de la API
# o se confirma con: npm run cli -- user:confirm <email>
REQUIRE_EMAIL_CONFIRMATION=true

# SMTP opcional para enviar los emails de confirmación: smtp://usuario:clave@host:587
SMTP_URL=
MAIL_FROM=Gestor de Gastos <no-reply@localhost>

# Vida de los tokens
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL_DAYS=60
